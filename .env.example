# HTTP listen port exposed by the bridge.
PORT=3001

# GMICloud API endpoint.
GMI_API_BASE_URL=https://console.gmicloud.ai

# Optional fallback key. If empty, the bridge uses the Authorization header
# sent by new-api's channel key.
GMI_API_KEY=

# Optional GMI organization header for multi-organization accounts.
GMI_ORG_ID=

# Persistent task metadata.
DATA_DIR=./data

# Upstream request timeout.
UPSTREAM_TIMEOUT_MS=60000

# Default model if a direct request omits model.
DEFAULT_MODEL=seedance-2-0-260128

# By default, a second image in content/images is mapped to GMI last_frame.
SECOND_IMAGE_AS_LAST_FRAME=true

# Optional model overrides. Values are GMICloud model IDs.
# MODEL_MAP_JSON={"my-business-model":"seedance-2-0-260128"}

# Billing compatibility for new-api's DoubaoVideo adapter.
# duration: report usage.total_tokens as generated seconds on succeeded tasks.
# zero: keep usage.total_tokens as 0.
BILLING_USAGE_MODE=duration
BILLING_DEFAULT_DURATION=5

# Optional effective-second multipliers by resolution.
# Example: BILLING_RESOLUTION_MULTIPLIERS_JSON={"480p":0.5,"720p":1,"1080p":2}
BILLING_RESOLUTION_MULTIPLIERS_JSON=
